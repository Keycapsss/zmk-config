#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define COLEMAK 1
#define NUM 2
#define SYM 3
#define ADJ 4
#define NAV 5

// Using mod-taps on thumbs or sides
&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

/ {
    chosen {
        zmk,physical-layout = &layout_ortho_4x12_all1u;
    };

    macros {
        macos_lock: macos_lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(Q))>;
        };
    };

    behaviors {
        // Mod-Tap behavior for Control/Escape
        mt_ctrl_esc: mt_ctrl_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_CTRL_ESC";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NUM SYM>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Base";
            bindings = <
                &kp TAB       &kp Q      &kp W      &kp E       &kp R          &kp T          &kp Y          &kp U          &kp I       &kp O      &kp P         &kp BKSP
                &mt LCTRL ESC &kp A      &kp S      &kp D       &kp F          &kp G          &kp H          &kp J          &kp K       &kp L      &kp SEMI      &kp QUOT
                &mt LSHIFT LPAR &kp Z    &kp X      &kp C       &kp V          &kp B          &kp N          &kp M          &kp COMMA   &kp DOT    &kp FSLH      &mt RSHIFT RPAR
                &kp LBKT      &kp LALT   &kp LGUI   &mo NAV     &mo NUM        &kp SPACE      &kp RET        &mo SYM        &mo NAV     &kp RGUI   &kp RALT      &kp RBKT
            >;
        };

        colemak_layer {
            label = "Colemak";
            bindings = <
                &kp TAB       &kp Q      &kp W      &kp F       &kp P          &kp G          &kp J          &kp L          &kp U       &kp Y      &kp SEMI      &kp BKSP
                &mt LCTRL ESC &kp A      &kp R      &kp S       &kp T          &kp D          &kp H          &kp N          &kp E       &kp I      &kp O         &kp QUOT
                &mt LSHIFT LPAR &kp Z    &kp X      &kp C       &kp V          &kp B          &kp K          &kp M          &kp COMMA   &kp DOT    &kp FSLH      &mt RSHIFT RPAR
                &kp LBKT      &kp LALT   &kp LGUI   &mo NAV     &mo NUM        &kp SPACE      &kp RET        &mo SYM        &mo NAV     &kp RGUI   &kp RALT      &kp RBKT
            >;
        };

        num_layer {
            label = "Num";
            bindings = <
                &trans     &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp DEL
                &trans     &kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &trans
                &trans     &kp MINUS  &kp EQUAL  &kp GRAVE  &kp BSLH   &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
            >;
        };

        sym_layer {
            label = "Sym";
            bindings = <
                &studio_unlock  &kp F11    &kp F12    &kp F13    &kp F14    &kp F15    &kp F16    &kp F17    &kp F18    &kp F19    &kp F20    &trans
                &trans          &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT  &kp CARET  &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &trans
                &trans          &kp UNDER  &kp PLUS   &kp TILDE  &kp PIPE   &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans          &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
            >;
        };

        adj_layer {
            label = "Adjust";
            bindings = <
                &trans     &bootloader &trans     &trans      &trans         &trans         &trans         &macos_lock    &trans      &trans        &trans        &trans
                &trans     &trans     &trans     &trans      &trans         &trans         &trans         &trans         &trans      &to COLEMAK   &to BASE      &trans
                &trans     &trans     &trans     &trans      &trans         &trans         &trans         &trans         &trans      &trans        &trans        &trans
                &trans     &trans     &trans     &trans      &trans         &trans         &trans         &trans         &trans      &trans        &trans        &trans
            >;
        };

        nav_layer {
            label = "Nav";
            bindings = <
                &trans     &kp C_PREV   &kp C_MUTE &kp C_PP    &kp C_NEXT    &trans         &trans         &kp HOME     &kp PG_DN  &kp PG_UP  &kp END      &trans
                &trans     &kp LC(LEFT) &kp LC(DOWN) &kp LC(UP) &kp LC(RIGHT) &trans         &trans         &kp LEFT     &kp DOWN   &kp UP     &kp RIGHT    &trans
                &trans     &trans       &kp C_VOL_DN &kp C_VOL_UP &trans     &trans         &trans         &trans       &kp C_BRI_DN &kp C_BRI_UP &trans     &trans
                &trans     &trans       &trans     &trans      &trans         &trans         &trans         &trans       &trans     &trans     &trans        &trans
            >;
        };
    };
};
